# LLM - Groq
GROQ_API_KEY=
# 트랙별 모델 지정 (비워두면 GROQ_MODEL, 그마저 없으면 openai/gpt-oss-20b 사용)
GROQ_MODEL_FAQ=
GROQ_MODEL_ORDER=

# 네이버 Clova STT + TTS (같은 앱)
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=

# CLOVA Speech (키워드 부스팅용 - 위와 별개 앱, NCP 콘솔에서 CLOVA Speech 앱 등록 후 Secret Key 발급)
CLOVA_SPEECH_SECRET=

# 어드민 로그인 (주석을 풀면 기본값 대신 이 값이 사용됨 — 빈 값으로 두지 말 것)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin1234
# JWT_SECRET=change-this-secret
# JWT_EXPIRE_MINUTES=480

# DB
DATABASE_URL=postgresql://kiosk:kiosk1234@db:5432/kiosk
